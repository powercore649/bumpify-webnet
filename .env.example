# ── Bumpify — Variables d'environnement ──────────────────────────────────
# Copie ce fichier en `.env` et remplis les valeurs. NE COMMIT JAMAIS le .env.

# Obligatoire
TOKEN=ton_token_discord_ici
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster/…

# Propriétaires du bot (IDs Discord, séparés par des virgules)
OWNER_IDS=123456789012345678,987654321098765432

# Média (optionnels — les modules correspondants restent silencieux sans eux)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GEMINI_API_KEY=
WEATHER_KEY=

# Divers
PUBLIC_URL=
WEB_PORT=3000
RESTART_LOG_CHANNEL_ID=
AUTH_ENCRYPTION_KEY=

# Site : déploiement instantané des commandes sur un serveur de test
DEV_GUILD_ID=
